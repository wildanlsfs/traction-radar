{
  "name": "traction-radar",
  "version": "0.1.0",
  "description": "AI agent that finds where an app's first users will come from, runs measurable growth experiments, and learns from real outcomes.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:mock": "MOCK_LLM=1 DB=memory node scripts/dev-server.mjs",
    "test": "MOCK_LLM=1 DB=memory node --test test/*.test.mjs",
    "build": "sam build",
    "deploy": "sam deploy --guided"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  }
}
